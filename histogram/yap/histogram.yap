/*
 * Histogram benchmark for YAP.
 * Usage: ./histogram <n>
 * Character-frequency histogram over a generated byte buffer (256-bucket
 * count array). Stand-in for "string processing" -- sequential byte
 * iteration with a data-dependent, unpredictable-to-the-branch-predictor
 * bucket index, contrasting with quicksort/lcs's numeric-array/DP access
 * patterns. Buffer is filled with splitmix64 (public domain, Vigna), same
 * generator as the lcs benchmark, reduced mod 256 for a full-byte-range
 * (not small-alphabet) distribution.
 */
import io
import stdlib

u64 fn splitmix64(u64 x) {
    x = x + 0x9E3779B97F4A7C15;
    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9;
    x = (x ^ (x >> 27)) * 0x94D049BB133111EB;
    x = x ^ (x >> 31);
    ret x;
}

// io module has no u64 print helper (only print_i32, which would truncate
// our checksum -- checksums here exceed i32 range even for small n), same
// approach as the quicksort benchmark's print_u64.
none fn print_u64(u64 v) {
    if (v == 0) {
        io->print_char(48);
        ret;
    }
    i32[24] digits;
    i32 n = 0;
    while (v > 0) {
        u64 d = v % 10;
        digits:[n] = d.(i32) + 48;
        v = v / 10;
        n = n + 1;
    }
    i32 i = n - 1;
    while (i >= 0) {
        io->print_char(digits:[i]);
        i = i - 1;
    }
}

none fn fill(byte@ buf, i32 n) {
    i32 i = 0;
    while (i < n) {
        u64 idx = (i + 1).(u64);
        buf:[i] = (splitmix64(idx) % 256).(byte);
        i = i + 1;
    }
    ret;
}

none fn histogram(byte@ buf, i32 n, u64@ counts) {
    i32 b = 0;
    while (b < 256) {
        counts:[b] = 0;
        b = b + 1;
    }
    i32 i = 0;
    while (i < n) {
        i32 bucket = buf:[i].(i32);
        counts:[bucket] = counts:[bucket] + 1;
        i = i + 1;
    }
    ret;
}

u64 fn checksum(u64@ counts) {
    u64 sum = 0;
    i32 b = 0;
    while (b < 256) {
        sum = sum + counts:[b] * (b + 1).(u64);
        b = b + 1;
    }
    ret sum;
}

i32 fn main(byte@[] args) {
    byte@ n_str = args:[1];
    i32 n = 0;
    i32 k = 0;
    while (n_str:[k] != 0) {
        n = n * 10 + n_str:[k].(i32) - 48;
        k = k + 1;
    }

    if (n <= 0) {
        print_u64(0);
        io->putchar(10);
        ret 0;
    }

    none@ buf_raw = stdlib->malloc(n.(i64));
    byte@ buf = buf_raw.(byte@);

    none@ counts_raw = stdlib->malloc((256 * 8).(i64));
    u64@ counts = counts_raw.(u64@);

    fill(buf, n);
    histogram(buf, n, counts);
    u64 result = checksum(counts);

    stdlib->free(buf_raw);
    stdlib->free(counts_raw);

    print_u64(result);
    io->putchar(10);
    ret 0;
}
